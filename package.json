{
  "name": "storage-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Storage Hunter – storage-unit auction simulator (vertical slice)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "vitest run tests/balance.sim.test.ts --reporter=verbose"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
